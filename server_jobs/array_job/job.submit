#!/bin/bash
#SBATCH --job-name='corr'
#SBATCH --output='out.%A_%a'
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=2G
#SBATCH --account=csd864
#SBATCH --export=ALL
#SBATCH -t 4:00:00
# one task per array index; N_TASKS must match the size of the array below
#SBATCH --array=0-111
N_TASKS=112
source ~/.bashrc
conda activate corr
# working directory is where you run the command
python -u sim.py $SLURM_ARRAY_TASK_ID $N_TASKS
